# ==============================================================================
# ACCELERA HUB — ENVIRONMENT VARIABLES EXAMPLE
# Copy file ini menjadi `.env.local` (untuk local dev) dan isi nilainya.
# ==============================================================================

# App URL (Opsional, berguna untuk Origin CORS Resumable Upload & QR Link)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Drive OAuth 2.0 REST API (Tanpa googleapis, akun Gmail 15 GB Private)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# 3. Notification Channels (Email & Telegram)
RESEND_API_KEY=re_your_resend_api_key
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# 4. Security & Cron Secret (Anti-Pause Supabase & SLA Reminder)
CRON_SECRET=your-strong-random-cron-secret